# Inject these environment variables; the application does not automatically load this file.
FAIR_DATABASE_URL=postgresql+psycopg://fair:fair@localhost:5432/fair
FAIR_CLIENT_KEYS={"my-app":"replace-with-random-client-key"}
FAIR_ADMIN_KEY=replace-with-separate-random-admin-key
# Alternatively use mounted secret files; omit the corresponding raw variable entirely.
# FAIR_CLIENT_KEYS_FILE=/run/secrets/fair_clients.json
# FAIR_ADMIN_KEY_FILE=/run/secrets/fair_admin.json
# Client file: JSON object. Admin file: JSON string. Restart after rotation.
FAIR_DEMO_MODE=0
# Optional live cloud credentials, only after private account/model review and opt-in.
# GROQ_API_KEY=replace-with-provider-key
# OPENROUTER_API_KEY=replace-with-provider-key
# See docs/LIVE_ADAPTERS.md. These are distinct from FAIR client/admin credentials.
# Optional operator review file, read at startup; never put private reviews in Git.
# FAIR_SOURCE_REVIEWS_FILE=config/source_reviews.local.yaml
# Optional private benchmark approvals, read at startup.
# FAIR_BENCHMARKS_FILE=config/benchmarks.local.yaml
# Opt-in native executor: build its trusted local image before setting these variables.
# FAIR_SANDBOX_IMAGE=sha256:<immutable-local-image-id>
# Stable, nonsecret owner enables scoped crash recovery at startup and before execution.
# FAIR_SANDBOX_OWNER=fair-development

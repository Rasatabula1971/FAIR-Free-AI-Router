# FAIR does not load this file automatically; pass FAIR(env_file=".env") or export the
# variables. Leave a key blank to skip that provider. Only free tiers are ever used.

GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
KILO_API_KEY=
ZAI_API_KEY=
NVIDIA_API_KEY=
OLLAMA_CLOUD_API_KEY=

# Optional cross-app quota coordination. Point every FAIR-powered app that shares
# provider accounts at the same SQLite path, but give each app a distinct name.
# Example Windows path: C:\FAIR Shared State\quota.sqlite3
FAIR_APPLICATION_ID=
FAIR_SHARED_QUOTA_PATH=

# Cloudflare Workers AI needs both values; FAIR meters the 10k neurons/day free allocation.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Local Ollama needs no key. Chat models are discovered from the running daemon.
OLLAMA_HOST=http://localhost:11434

# Optional central FAIR HTTP service. Keep the service on loopback unless you
# intentionally secure and expose it to another machine.
FAIR_SERVICE_HOST=127.0.0.1
FAIR_SERVICE_PORT=8000

# JSON map of application id -> FAIR client bearer key. These keys authenticate
# applications to FAIR; they are NOT provider API keys. Use unique random values
# of at least 16 characters.
FAIR_SERVICE_CLIENTS={"corp":"replace-with-random-client-key","youtube-production":"replace-with-another-random-key"}

# Recurring-free providers still require explicit operator confirmation.
# Example: google_gemini_api,groq,mistral,zai_free,cloudflare_workers_ai
FAIR_CONFIRMED_FREE_PROVIDERS=

# Optional JSON map when multiple provider accounts/projects need distinct
# quota pools. Omit it when all apps share the same provider account.
FAIR_QUOTA_POOL_IDS=

# FAIR does not load this file automatically; pass FAIR(env_file=".env") or export the
# variables. Leave a key blank to skip that provider. Only free tiers are ever used.

GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
# Optional: Mistral Admin API access is currently an Enterprise capability.
# Normal Free-mode users should leave this blank.
MISTRAL_ADMIN_API_KEY=
OPENROUTER_API_KEY=
KILO_API_KEY=
NVIDIA_API_KEY=
OLLAMA_CLOUD_API_KEY=

# Optional cross-app quota coordination. Point every FAIR-powered app that shares
# provider accounts at the same SQLite path, but give each app a distinct name.
# Example Windows path: C:\FAIR Shared State\quota.sqlite3
FAIR_APPLICATION_ID=
FAIR_SHARED_QUOTA_PATH=

# Cloudflare Workers AI needs both values. Only confirm it when the account is on
# Workers Free; Cloudflare hard-stops the 10k-neuron/day free allocation with error 3036.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional: an unmodified FreeLLMAPI gateway on this host, used as one provider.
# All three are needed, plus freellmapi in FAIR_CONFIRMED_FREE_PROVIDERS. The review
# file lists each model and the X-Routed-Via routes it may be answered from, and
# expires 30 days after its reviewed_at. See "FreeLLMAPI as a provider" in the README.
FREELLMAPI_API_KEY=
FREELLMAPI_URL=http://127.0.0.1:3001
FREELLMAPI_REVIEW=

# Local Ollama needs no key. Chat models are discovered from the running daemon.
OLLAMA_HOST=http://localhost:11434

# Optional central FAIR HTTP service. v0.2 is intentionally loopback-only;
# non-loopback FAIR_SERVICE_HOST values are rejected.
FAIR_SERVICE_HOST=127.0.0.1
FAIR_SERVICE_PORT=8000

# JSON map of application id -> FAIR client bearer key. These keys authenticate
# applications to FAIR; they are NOT provider API keys. Use unique random values
# of at least 16 characters.
FAIR_SERVICE_CLIENTS={"corp":"replace-with-random-client-key","youtube-production":"replace-with-another-random-key"}

# Optional operator-only key for provider recovery actions. It must be different
# from every application client key. Leave blank to disable the admin endpoint.
FAIR_SERVICE_ADMIN_KEY=

# Persistent operator confirmation for recurring-free provider accounts.
# The Windows test console reads this value directly, so you do not need to
# answer Y/N on every test run.
# Example: google_gemini_api,groq,mistral,cloudflare_workers_ai
FAIR_CONFIRMED_FREE_PROVIDERS=

# Optional JSON map when multiple provider accounts/projects need distinct
# quota pools. Omit it when all apps share the same provider account.
FAIR_QUOTA_POOL_IDS=

# Operator-only. Keeps the last non-200 provider message per adapter (bounded and
# credential-scrubbed) so an HTTP_400 can be diagnosed. Raised codes and the attempt
# log are unchanged either way. Leave blank to keep it off.
FAIR_PROVIDER_ERROR_DIAGNOSTICS=

# Assumed free-tier output throughput, used to size the per-attempt budget
# (timeout_seconds + max_output_tokens / this, bounded by max_timeout_seconds).
# It never promises a rate; it decides how long FAIR waits before calling an
# attempt failed. Leave blank for the default of 40, measured on 2026-09-30.
FAIR_OUTPUT_TOKENS_PER_SECOND=
